# PACT — environment variables. Copy to .env.local for local development.
# Nothing here is required to run locally: without PayPal credentials PACT uses a clearly
# labelled payment simulator, and without a database URL it uses in-process Postgres (PGlite).

# ── PayPal Sandbox (https://developer.paypal.com/dashboard/applications/sandbox) ──────────────
# REST app credentials. Sandbox only: PACT refuses to talk to the live API.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Set to "simulated" to force the labelled payment simulator even when credentials are present (tests, CI).
PACT_PAYMENT_MODE=
# Webhook id for signature verification. Create it with:
#   npx tsx scripts/paypal-webhook-register.ts https://<your-host>/api/webhooks/paypal
PAYPAL_WEBHOOK_ID=

# ── AI (Vercel AI Gateway) ────────────────────────────────────────────────────────────────────
# On Vercel the gateway authenticates with the deployment's OIDC token automatically.
# Locally either run `vercel env pull .env.local` (adds VERCEL_OIDC_TOKEN, valid 12h) or set a key:
AI_GATEWAY_API_KEY=
# Optional model overrides (gateway ids).
PACT_MODEL_BUYER=google/gemini-2.5-flash
PACT_MODEL_SELLER=openai/gpt-5-mini
PACT_MODEL_VERIFIER=google/gemini-2.5-flash
# Seller studio (art direction, copy) and the read-only PayPal auditor agent.
PACT_MODEL_STUDIO=google/gemini-2.5-flash
PACT_MODEL_OPS=google/gemini-2.5-flash
# Comma-separated models the gateway falls back to when a role's primary model fails.
PACT_MODEL_FALLBACKS=openai/gpt-5-mini,google/gemini-2.5-flash
# Set to "scripted" to run deterministic agents with no model calls (tests, CI, offline).
PACT_AI_MODE=

# ── Database ──────────────────────────────────────────────────────────────────────────────────
# Postgres connection string (pooled). Leave empty to use PGlite.
DATABASE_URL=
# Optional direct (unpooled) connection used for migrations at build time.
DATABASE_URL_UNPOOLED=
# Directory for the local PGlite database (omit for in-memory). A relative path is resolved
# against the project directory. PGlite allows one process per directory.
PGLITE_DIR=.pact-data/dev

# ── App ───────────────────────────────────────────────────────────────────────────────────────
# Signs the anonymous session cookie. Required in production. Generate: openssl rand -hex 32
SESSION_SECRET=
# Operator token for privileged actions (connecting the shared demo wallet, seeding showcase deals).
ADMIN_TOKEN=
# Public base URL (used for PayPal return URLs). Defaults to the request origin.
APP_URL=

# ── AG Studio (optional) ──────────────────────────────────────────────────────────────────────
# Trial or production licence key. Without it AG Studio runs in trial mode with a watermark.
NEXT_PUBLIC_AG_LICENSE_KEY=
